{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": [
    "shared/src",
    "server/src",
    "server/test",
    "client/src",
    "client/vite.config.ts",
    "e2e",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
